# Copy to .env (or export these) - all optional.
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
CORS_ORIGINS=http://localhost:3000
MATCH_CUTOFF=85
WEAK_MATCH_FLOOR=60
CGHS_TOLERANCE=0.05
DEFAULT_ACCREDITATION=nabh
MAX_FILE_SIZE_MB=10
